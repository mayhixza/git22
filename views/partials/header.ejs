<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Document</title>
		<link
			href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css"
			rel="stylesheet"
			integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi"
			crossorigin="anonymous"
		/>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		<style>
			* {
				font-family: "Poppins", sans-serif;
			}
			.logo {
				font-weight: 500;
				font-size: 22px;
			}
			.login-btn {
				border-radius: 10pc;
				font-size: 15px;
				padding: 7px 2rem;
			}
		</style>
	</head>
	<body>
		<div class="container-sm pt-2 d-flex" style="max-width: 80%">
			<div class="row w-100 align-items-center">
				<div class="col-1">
					<!-- <h3 class="logo">Logo</h3> -->
					<img src="/logo.png" alt="logo" style="width: 50px" />
				</div>
				<div class="col">
					<ul class="d-flex w-100 justify-content-center h-100 m-0">
						<% if (isAdmin) { %>
						<li class="px-3 list-unstyled">
							<a
								href="/admin/dashboard"
								class="text-decoration-none text-transform-capitalize"
								>Dashboard</a
							>
						</li>
						<li class="px-3 list-unstyled">
							<a
								href="/admin/links"
								class="text-decoration-none text-transform-capitalize"
								>Webinar</a
							>
						</li>
						<li class="px-3 list-unstyled">
							<a
								href="/admin/counsellor"
								class="text-decoration-none text-transform-capitalize"
								>Counsellor</a
							>
						</li>
						<% } else { %>
						<li class="px-3 list-unstyled">
							<a
								href="/user/links"
								class="text-decoration-none text-transform-capitalize"
								>Webinar</a
							>
						</li>
						<li class="px-3 list-unstyled">
							<a
								href="/user/counsellor"
								class="text-decoration-none text-transform-capitalize"
								>Counsellor</a
							>
						</li>
						<li class="px-3 list-unstyled">
							<a
								href="/user/profile"
								class="text-decoration-none text-transform-capitalize"
								>Profile</a
							>
						</li>
						<% }%>
					</ul>
				</div>
				<div
					class="col-3 justify-content-end align-items-end"
					style="text-align: right"
				>
					<a href="/auth/logout">
						<button class="btn btn-outline-primary login-btn">
							<% if (isLoggedIn){ %> Log Out <% } else {%> Login
							<% }%>
						</button>
					</a>
				</div>
			</div>
		</div>
	</body>
</html>
