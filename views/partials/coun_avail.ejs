<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Document</title>
		<style>
			.time_item {
				background: linear-gradient(315deg, #eb4786 0%, #b854a6 74%);
				border-radius: 10px;
				padding: 7px;
				color: #fff;
				width: 30%;
				text-align: center;
			}
		</style>
	</head>
	<body>
		<div
			class="container-lg"
			style="
				max-width: 70%;
				box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
				border-radius: 10px;
				margin: 3rem auto;
				margin-bottom: 2rem;
				padding: 1rem;
			"
		>
			<div
				style="
					width: 100%;
					border-bottom: 1px solid #ddd;
					padding: 5px 10px 10px 10px;
					display: flex;
					align-items: center;
					justify-content: space-between;
				"
			>
				<h2 style="font-size: 19px">Counsellor Availability</h2>
				<button
					type="submit"
					class="btn btn-outline-primary"
					style="font-size: 15px; padding: 8px 20px"
				>
					Add New Slot
				</button>
			</div>
			<table class="table">
				<tbody>
					<tr>
						<th
							scope="row"
							style="
								font-size: 15px;
								font-weight: 500;
								display: flex;
								align-items: center;
							"
						>
							<span style="min-width: 120px">Monday</span>
							<p class="time_item m-0">9:00 AM - 12:00 PM</p>
						</th>
					</tr>
					<tr>
						<th
							scope="row"
							style="
								font-size: 15px;
								font-weight: 500;
								display: flex;
								align-items: center;
							"
						>
							<span style="min-width: 120px"> Tuesday </span>
							<p class="time_item m-0" style="opacity: 0"></p>
							<p class="time_item m-0">1:00 AM - 3:00 PM</p>
						</th>
					</tr>
					<tr>
						<th
							scope="row"
							style="
								font-size: 15px;
								font-weight: 500;
								display: flex;
								align-items: center;
							"
						>
							<span style="min-width: 120px"> Wednesday </span>

							<p class="time_item m-0">9:00 AM - 12:00 PM</p>
						</th>
					</tr>
					<tr>
						<th
							scope="row"
							style="
								font-size: 15px;
								font-weight: 500;
								display: flex;
								align-items: center;
							"
						>
							<span style="min-width: 120px"> Thursday </span>
							<p class="time_item m-0">9:00 AM - 12:00 PM</p>
						</th>
					</tr>
					<tr>
						<th
							scope="row"
							style="
								font-size: 15px;
								font-weight: 500;
								display: flex;
								align-items: center;
							"
						>
							<span style="min-width: 120px"> Friday </span>
							<p class="time_item m-0" style="opacity: 0"></p>
							<p class="time_item m-0" style="opacity: 0"></p>
							<p class="time_item m-0">9:00 AM - 12:00 PM</p>
						</th>
					</tr>
					<tr>
						<th
							scope="row"
							style="
								font-size: 15px;
								font-weight: 500;
								display: flex;
								align-items: center;
							"
						>
							<span style="min-width: 120px"> Saturday </span>
							<p class="time_item m-0" style="opacity: 0"></p>
							<p class="time_item m-0">9:00 AM - 12:00 PM</p>
						</th>
					</tr>
					<tr>
						<th
							scope="row"
							style="
								font-size: 15px;
								font-weight: 500;
								display: flex;
								align-items: center;
							"
						>
							<span style="min-width: 120px"> Sunday </span>
							<p class="time_item m-0">9:00 AM - 12:00 PM</p>
						</th>
					</tr>
				</tbody>
			</table>
		</div>
	</body>
</html>
