<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>User Profile</title>
		<link
			href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css"
			rel="stylesheet"
			integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi"
			crossorigin="anonymous"
		/>

		<style>
			.pfp {
				width: 180px;
				height: 180px;
				border-radius: 50%;
			}
			.custom-card {
				border-radius: 10px;
				padding: 1rem;
				min-height: 175px;
				box-shadow: 0px 0px 7px rgba(0, 0, 0, 0.4);
			}
			.bg-1 {
				background: linear-gradient(315deg, #875fc0 0%, #5346ba 74%);
			}
			.bg-2 {
				background: linear-gradient(315deg, #eb4786 0%, #b854a6 74%);
			}
		</style>
	</head>
	<body>
		<%- include("../partials/header", {isLoggedIn: isLoggedIn, isAdmin:
		isAdmin}) %>
		<div class="container-lg pt-5" style="max-width: 80%">
			<div
				class="d-flex w-100 align-items-center"
				style="padding: 0 5rem"
			>
				<img
					src="https://images.unsplash.com/photo-1633332755192-727a05c4013d?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=580&q=80"
					class="img-responsive pfp"
				/>
				<div class="mx-4">
					<h3
						style="
							font-size: 21px;
							font-weight: 400;
							margin-bottom: 4px;
						"
					>
						<%= user.name %>
					</h3>
					<p class="m-0 text-secondary" style="font-size: 16px">
						<%= user.username %>
					</p>
					<p class="m-0 text-secondary" style="font-size: 16px">
						Class: <%= user.class %>
					</p>
				</div>
			</div>
			<div class="row gap-4 w-100 d-flex justify-content-center mt-5">
				<div class="col-4 custom-card position-relative bg-1">
					<p class="text-white-50 mb-2" style="font-size: 15px">
						Attendance
					</p>
					<h3
						class="text-white"
						style="margin-top: 5px; font-size: 27px"
					>
						98/105
					</h3>
					<img
						src="/card_bg.svg"
						class="position-absolute bottom-0"
						style="left: 0"
					/>
				</div>
				<div class="col-4 custom-card position-relative bg-2">
					<p class="text-white-50 mb-2" style="font-size: 15px">
						Percentage
					</p>
					<h3
						class="text-white"
						style="margin-top: 5px; font-size: 27px"
					>
						89%
					</h3>
					<img
						src="/card_bg.svg"
						class="position-absolute bottom-0"
						style="left: 0"
					/>
				</div>
			</div>

			<div
				class="accordion accordion-flush mt-5 mx-5"
				id="accordionFlushExample"
			>
				<div class="accordion-item">
					<h2 class="accordion-header" id="flush-headingOne">
						<button
							class="accordion-button collapsed"
							type="button"
							data-bs-toggle="collapse"
							data-bs-target="#flush-collapseOne"
							aria-expanded="false"
							aria-controls="flush-collapseOne"
						>
							<img
								src="/quality.png"
								style="width: 22px; height: 22px"
							/>
							<span class="mx-2">Achievement</span>
						</button>
					</h2>
					<div
						id="flush-collapseOne"
						class="accordion-collapse collapse"
						aria-labelledby="flush-headingOne"
						data-bs-parent="#accordionFlushExample"
					>
						<div class="accordion-body">
							<table class="table table-striped">
								<thead>
									<tr>
										<th scope="col" style="font-size: 15px">
											#
										</th>
										<th
											scope="col"
											style="font-size: 14.5px"
										>
											Event
										</th>
										<th
											scope="col"
											style="font-size: 14.5px"
										>
											Position
										</th>
										<th
											scope="col"
											style="font-size: 14.5px"
										>
											Date
										</th>
										<th
											scope="col"
											style="font-size: 14.5px"
										>
											Category
										</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<th scope="row">1</th>
										<td>Inter DPS</td>
										<td>1st</td>
										<td>23 Sep, 2022</td>
										<td>Tech</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
				<div class="accordion-item">
					<h2 class="accordion-header" id="flush-headingTwo">
						<button
							class="accordion-button collapsed"
							type="button"
							data-bs-toggle="collapse"
							data-bs-target="#flush-collapseTwo"
							aria-expanded="false"
							aria-controls="flush-collapseTwo"
						>
							<img
								src="/grade.png"
								style="width: 22px; height: 22px"
							/>
							<span class="mx-2">Grade</span>
						</button>
					</h2>
					<div
						id="flush-collapseTwo"
						class="accordion-collapse collapse"
						aria-labelledby="flush-headingTwo"
						data-bs-parent="#accordionFlushExample"
					>
						<div class="accordion-body">
							<table class="table table-striped">
								<thead>
									<tr>
										<th scope="col" style="font-size: 15px">
											Subject
										</th>
										<th
											scope="col"
											style="font-size: 14.5px"
										>
											1st Semester/100
										</th>
										<th
											scope="col"
											style="font-size: 14.5px"
										>
											2nd Semester/100
										</th>
										<th
											scope="col"
											style="font-size: 14.5px"
										>
											3rd Semester/100
										</th>
										<th
											scope="col"
											style="font-size: 14.5px"
										>
											4th Semester/100
										</th>
										<th
											scope="col"
											style="font-size: 14.5px"
										>
											Total
										</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<th scope="row">Maths</th>
										<td>89</td>
										<td>90</td>
										<td>78</td>
										<td>98</td>
										<td>90</td>
									</tr>
									<tr>
										<th scope="row">English</th>
										<td>89</td>
										<td>90</td>
										<td>78</td>
										<td>98</td>
										<td>90</td>
									</tr>
									<tr>
										<th scope="row">Cs</th>
										<td>89</td>
										<td>90</td>
										<td>78</td>
										<td>98</td>
										<td>90</td>
									</tr>
									<tr>
										<th scope="row">Physics</th>
										<td>89</td>
										<td>90</td>
										<td>78</td>
										<td>98</td>
										<td>90</td>
									</tr>
									<tr>
										<th scope="row">Chemistry</th>
										<td>89</td>
										<td>90</td>
										<td>78</td>
										<td>98</td>
										<td>90</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>

		<script
			src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"
			integrity="sha384-oBqDVmMz9ATKxIep9tiCxS/Z9fNfEXiDAYTujMAeBAsjFuCZSmKbSSUnQlmh/jp3"
			crossorigin="anonymous"
		></script>
		<script
			src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.min.js"
			integrity="sha384-IDwe1+LCz02ROU9k972gdyvl+AESN10+x7tBKgc9I5HFtuNz0wWnPclzo6p9vxnk"
			crossorigin="anonymous"
		></script>
	</body>
</html>
