<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Document</title>
		<style>
			.institute-card {
				background-color: #fff;
				box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
				padding: 0;
				border-radius: 10px;
			}
			.img {
				width: 100%;
				height: 220px;
				border-radius: 10px;
			}
			.custom-btn {
				margin-right: 25px;
				padding: 8px 15px !important;
				font-size: 13px !important;
				box-shadow: 0 0 5px rgba(0, 0, 0, 0.4) !important;
			}
		</style>
	</head>
	<body>
		<%- include("../partials/header", {isLoggedIn: isLoggedIn, isAdmin:
		isAdmin}) %>

		<div class="container-lg pt-5" style="max-width: 65%">
			<% links.forEach(link => {%>
			<div class="row w-100 my-3">
				<div class="col institute-card">
					<div
						class="row"
						style="padding: 1.7rem 2rem; box-sizing: border-box"
					>
						<div class="col d-flex flex-column">
							<div style="flex: 1; padding-top: 1rem">
								<h3
									style="
										font-size: 20px;
										text-transform: capitalize;
									"
								>
									<%= link.name %>
								</h3>
								<a
									href="https://www.universityofcalifornia.edu/"
									style="
										font-size: 16px;
										text-decoration: none;
										display: flex;
										align-items: center;
									"
								>
									<img
										src="/location.png"
										alt="location"
										style="width: 20px"
									/>
									<span class="mx-1"><%= link.link %></span>
								</a>
							</div>
							<div
								class="d-flex align-items-center justify-content-between"
							>
								<p class="m-0" style="font-size: 15px">
									Date: <%= link.date %>
								</p>
								<button class="custom-btn btn btn-primary">
									Set Reminder
								</button>
							</div>
						</div>
						<div class="col-5" style="text-align: right">
							<img
								src="https://edsource.org/wp-content/uploads/2017/04/08.UCLA_.Royce_.jpg"
								alt="institute"
								class="img"
							/>
						</div>
					</div>
				</div>
			</div>
			<% }) %>
		</div>
	</body>
</html>
