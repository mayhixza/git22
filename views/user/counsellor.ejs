<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Document</title>
	</head>
	<body>
		<%- include("../partials/header", {isLoggedIn: isLoggedIn, isAdmin:
		isAdmin}) %> <%-include("../partials/coun_avail") %>

		<div
			class="container-lg"
			style="
				max-width: 70%;
				box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
				border-radius: 10px;
				margin: 1rem auto;
			"
		>
			<div
				style="
					width: 100%;
					border-bottom: 1px solid #ddd;
					padding: 1rem 1rem 5px 1rem;
				"
			>
				<h2 style="font-size: 20px">Book Slot</h2>
			</div>
			<div style="padding: 2rem; padding-bottom: 1rem">
				<div style="display: flex">
					<div style="flex: 1; margin-right: 1rem">
						<input
							type="text"
							id="name"
							name="username"
							placeholder="Username"
							required
							class="form-control"
							style="margin: 10px 0; padding: 10px 15px"
						/>
						<input
							type="text"
							id="name"
							name="username"
							placeholder="Class"
							required
							class="form-control"
							style="margin: 10px 0; padding: 10px 15px"
						/>
						<input
							type="text"
							id="name"
							name="username"
							placeholder="Time"
							required
							class="form-control"
							style="margin: 10px 0; padding: 10px 15px"
						/>
					</div>
					<div style="flex: 1">
						<textarea
							type="text"
							id="name"
							name="username"
							placeholder="Description"
							required
							class="form-control"
							style="
								margin: 10px 0;
								padding: 10px 15px;
								min-height: 100px;
							"
						></textarea>
					</div>
				</div>
				<button
					type="submit"
					class="btn btn-outline-primary"
					style="font-size: 15px; padding: 8px 20px; margin-top: 1rem"
				>
					Sign Up
				</button>
			</div>
		</div>

		<div
			class="container-lg"
			style="
				max-width: 70%;
				box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
				border-radius: 10px;
				margin: 1rem auto;
			"
		>
			<div
				style="
					width: 100%;
					border-bottom: 1px solid #ddd;
					padding: 1rem 1rem 5px 1rem;
				"
			>
				<h2 style="font-size: 20px">Directly upload to your profile</h2>
			</div>
			<div
				style="
					display: flex;
					align-items: center;
					justify-content: center;
					flex-direction: column;
					padding: 1rem;
				"
			>
				<img src="/upload.png" alt="" style="width: 170px" />
				<p style="font-size: 18px; color: #444; font-weight: 500">
					Upload your profile
				</p>
				<button
					type="upload"
					class="btn btn-outline-primary position-relative"
					style="font-size: 15px; padding: 8px 20px"
				>
					<input
						type="file"
						style="
							width: 100%;
							height: 100%;
							position: absolute;
							top: 0;
							left: 0;
							opacity: 0;
						"
					/>
					Upload
				</button>
			</div>
		</div>
	</body>
</html>
