<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Admin Links</title>
		<style>
			.institute-card {
				background-color: #fff;
				box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
				padding: 0;
				border-radius: 10px;
			}
			.img {
				width: 100%;
				height: 220px;
				border-radius: 10px;
			}
			.custom-btn {
				margin-right: 25px;
				padding: 8px 15px !important;
				font-size: 13px !important;
				box-shadow: 0 0 5px rgba(0, 0, 0, 0.4) !important;
			}
		</style>
	</head>
	<body>
		<%- include("../partials/header", {isLoggedIn: isLoggedIn, isAdmin:
		isAdmin}) %>

		<div
			class="container-lg pt-5 d-flex flex-column"
			style="max-width: 60%"
		>
			<div class="error-wrap">
				<% if(locals.error){ %>
				<p class="error"><%= locals.error %></p>
				<% } %>
			</div>
			<form action="/admin/links" method="POST" style="width: 40%">
				<h3
					style="
						font-size: 20px;
						margin-bottom: 1.5rem;
						margin-top: 0.4rem;
					"
				>
					Add New webinar
				</h3>
				<input
					type="text"
					id="name"
					name="name"
					placeholder="Name of Institute"
					required
					class="form-control"
					style="margin: 10px 0; padding: 10px 15px"
				/>

				<input
					type="text"
					id="link"
					name="link"
					placeholder="Link"
					required
					class="form-control"
					style="margin: 10px 0; padding: 10px 15px"
				/>

				<input
					type="text"
					id="date"
					name="date"
					placeholder="Date of webinar (dd/mm/yyyy)"
					required
					class="form-control"
					style="margin: 10px 0; padding: 10px 15px"
				/>

				<button type="submit" class="btn btn-outline-primary">
					Add webinar</button
				><br />
			</form>
		</div>

		<div class="container-lg mt-4" style="max-width: 60%">
			<% links.forEach(link => {%>
			<div class="row w-100 my-3">
				<div class="col institute-card">
					<div
						class="row"
						style="padding: 1.7rem 2rem; box-sizing: border-box"
					>
						<div class="col d-flex flex-column">
							<div style="flex: 1; padding-top: 1rem">
								<h3
									style="
										font-size: 20px;
										text-transform: capitalize;
									"
								>
									<%= link.name %>
								</h3>
								<a
									href="https://www.universityofcalifornia.edu/"
									style="
										font-size: 16px;
										text-decoration: none;
										display: flex;
										align-items: center;
									"
								>
									<img
										src="/location.png"
										alt="location"
										style="width: 20px"
									/>
									<span class="mx-1"><%= link.link %></span>
								</a>
							</div>
							<div
								class="d-flex align-items-center justify-content-between"
							>
								<p class="m-0" style="font-size: 15px">
									Date: <%= link.date %>
								</p>
								<button class="custom-btn btn btn-primary">
									Set Reminder
								</button>
							</div>
						</div>
						<div class="col-5" style="text-align: right">
							<img
								src="https://edsource.org/wp-content/uploads/2017/04/08.UCLA_.Royce_.jpg"
								alt="institute"
								class="img"
							/>
						</div>
					</div>
				</div>
			</div>
			<% }) %>
		</div>
	</body>
</html>
